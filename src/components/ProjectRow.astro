---
import { type Lang, projects } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: typeof projects[number]; lang: Lang; }
const {project,lang}=Astro.props;
---
<a href={project.repo} class:list={['project-row','project-'+project.visual]} target="_blank" rel="noopener noreferrer">
  <ProjectVisual variant={project.visual}/>
  <div class="project-summary">
    <div class="project-topline"><span>{project.number} / ENGINEERING CASE STUDY</span><span class="project-link-symbol" aria-hidden="true">↗</span></div>
    <h3>{project.title}<span class="project-title-period">.</span></h3>
    <p>{project.detail[lang]}</p>
    <div class="project-tags">{project.stack.map(item=><span>{item}</span>)}</div>
    <span class="project-bottomline"><span>GITHUB / SOURCE CODE</span><span aria-hidden="true">EXPLORE ↗</span></span>
  </div>
</a>
