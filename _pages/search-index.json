---
layout: null
permalink: /search-index.json
---
[
{% assign published = site.articles | where: "review_status", "approved" %}
{% for item in published %}
  {"title":{{ item.title | jsonify }},"description":{{ item.description | jsonify }},"lang":{{ item.lang | jsonify }},"topic":{{ item.topic | jsonify }},"url":{{ item.url | relative_url | jsonify }},"date":{{ item.date | date: "%Y-%m-%d" | jsonify }},"text":{{ item.content | strip_html | strip_newlines | truncate: 1400 | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
